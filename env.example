# Эти значения вводятся в Railway -> Variables, в репозиторий реальные токены не кладём
TG_TOKEN=
DC_TOKEN=
WEBAPP_URL=https://ЛОГИН.github.io/vyshegrad-app/index.html
ADMIN_WEBAPP_URL=https://ЛОГИН.github.io/vyshegrad-app/admin.html
API_URL=https://ТВОЙ-ДОМЕН.up.railway.app/api/me
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
NEWBIE_ROLE_ID=
CITIZEN_ROLE_ID=
ADMIN_IDS=
FORM_URL=
FORM_RESP_URL=
