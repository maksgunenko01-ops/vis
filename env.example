# Через сколько часов после отказа можно подать апелляцию снова (по умолчанию 24)
APPEAL_COOLDOWN_H=24

# Сколько выплат /work нужно на +1 уровень (по умолчанию 5)
WORKS_PER_LEVEL=5

# Форма «Сдача теории» (права): адрес и ключ из exam_answers.gs
EXAM_SCRIPT_URL=
